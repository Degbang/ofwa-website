# Web3Forms access key. Every form on the site (contact, volunteer, partner, donate, hub applications) posts here.
VITE_WEB3FORMS_KEY=

# Supabase project (Settings > API). Powers /admin and the live Events, Gallery and Hubs content.
# Leave empty to serve the built-in content. The anon key is public by design; row-level security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
